# Leave VITE_API_URL unset when the host reverse-proxies /api to the backend.
# For a separate API origin, use its public HTTPS /api URL and deploy the UI/API
# under the same site so the existing SameSite=Lax session cookie is sent.
# VITE_API_URL=https://api.example.com/api

# Public HTTPS application origin used by mobile evidence capture.
# VITE_PUBLIC_APP_URL=https://nawi.example.com
