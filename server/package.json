{
  "name": "nawi-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/build/copyDemoSeedFixture.mjs",
    "test": "npm run build && node scripts/testing/runTests.mjs",
    "test:report-review": "npm run build && node --test dist/services/reportReview.test.js",
    "test:instrument-deletion": "npm run build && node --test dist/services/instrumentDeletion.test.js",
    "test:demo-scope": "npm run build && node --test dist/services/demoWorkspace.test.js dist/services/reviewerWorkspaceScope.test.js",
    "start": "node dist/index.js",
    "seed:production-demo": "node dist/scripts/productionDemoSeed.js",
    "test:production-demo-seed": "npm run build && node scripts/testing/runProductionDemoSeedTest.mjs",
    "seed:admin": "tsx scripts/seed/seedAdmin.ts",
    "reset:test-data": "tsx scripts/reset/resetTestData.ts",
    "reset:tare-phase": "tsx scripts/maintenance/resetTarePhase.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
