PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nawi-test-report
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Public HTTPS application origin used to construct QR phone-upload URLs in production.
# Required for production QR capture unless Vercel supplies its deployment URL.
# VITE_PUBLIC_APP_URL=https://nawi.example.com
# Optional: use a LAN-reachable URL when the QR is scanned by a physical phone.
# Development only; never set this to a private LAN URL in production.
# MOBILE_CAPTURE_BASE_URL=http://<PC-LAN-IP>:5173
# Optional phone-upload token lifetime in seconds (default 900, minimum 60).
# EVIDENCE_SESSION_TTL_SECONDS=900
# Optional initial administrator, for an explicit seed:admin command only.
INITIAL_ADMIN_EMAIL=admin@example.gov
INITIAL_ADMIN_PASSWORD=change-this-development-password
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
